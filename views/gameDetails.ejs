<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Iceland&family=Roboto:ital,wght@0,100..900;1,100..900&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/navbar.css">
    <link rel="stylesheet" href="/game-details.css">
    <title><%= title %></title>
</head>
<body class="game-details-body">
    <%- include('./partials/navbar.ejs') %>
    <img src="<%= game.image_url %>" class="game-cover">
    <div class="game-container">
        <p class="game-title"><%= game.title %></p>
        <small class="game-releasedate"><%= new Date(game.release_date).toLocaleDateString('en-GB') %></small>
        <p class="game-genre <%= game.genre_name.toLowerCase() %>"><%= game.genre_name %></p>
        <p class="game-description"><%= game.description %></p>
    </div>
    <div class="options">
        <a href="/games/<%= game.id %>/edit" class="update-btn">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                <path d="M12 8.00012L4 16.0001V20.0001L8 20.0001L16 12.0001M12 8.00012L14.8686 5.13146L14.8704 5.12976C15.2652 4.73488 15.463 4.53709 15.691 4.46301C15.8919 4.39775 16.1082 4.39775 16.3091 4.46301C16.5369 4.53704 16.7345 4.7346 17.1288 5.12892L18.8686 6.86872C19.2646 7.26474 19.4627 7.46284 19.5369 7.69117C19.6022 7.89201 19.6021 8.10835 19.5369 8.3092C19.4628 8.53736 19.265 8.73516 18.8695 9.13061L18.8686 9.13146L16 12.0001M12 8.00012L16 12.0001" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span>Update</span>
        </a>
        <form id="delete-form" method="POST" action="/games/<%= game.id %>/delete">
            <button type="button" class="delete-btn" id="delete-btn">
                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                    <path d="M14 10V17M10 10V17M6 6V17.8C6 18.9201 6 19.4798 6.21799 19.9076C6.40973 20.2839 6.71547 20.5905 7.0918 20.7822C7.5192 21 8.07899 21 9.19691 21H14.8031C15.921 21 16.48 21 16.9074 20.7822C17.2837 20.5905 17.5905 20.2839 17.7822 19.9076C18 19.4802 18 18.921 18 17.8031V6M6 6H8M6 6H4M8 6H16M8 6C8 5.06812 8 4.60241 8.15224 4.23486C8.35523 3.74481 8.74432 3.35523 9.23438 3.15224C9.60192 3 10.0681 3 11 3H13C13.9319 3 14.3978 3 14.7654 3.15224C15.2554 3.35523 15.6447 3.74481 15.8477 4.23486C15.9999 4.6024 16 5.06812 16 6M16 6H18M18 6H20" stroke="white" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span>Delete</span>
            </button>
        </form>
    </div>
    <p class="availability">Available on:</p>
    <div class="availability-menu">
        <% platforms.forEach(({platform_name}) => { %>
            <% if(platform_name === 'PlayStation 5') {%>
                <svg aria-hidden="true" focusable="false" class="shared-nav-ps-logo" width="35px" height="35px" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 50 50" data-di-res-id="68f0b586-45042df1" data-di-rand="1789830843418">
                    <g>
                        <g>
                        <path d="M5.8,32.1C4.3,33.1,4.8,35,8,35.9c3.3,1.1,6.9,1.4,10.4,0.8c0.2,0,0.4-0.1,0.5-0.1v-3.4l-3.4,1.1
                    c-1.3,0.4-2.6,0.5-3.9,0.2c-1-0.3-0.8-0.9,0.4-1.4l6.9-2.4V27l-9.6,3.3C8.1,30.7,6.9,31.3,5.8,32.1z M29,17.1v9.7
                    c4.1,2,7.3,0,7.3-5.2c0-5.3-1.9-7.7-7.4-9.6C26,11,23,10.1,20,9.5v28.9l7,2.1V16.2c0-1.1,0-1.9,0.8-1.6C28.9,14.9,29,16,29,17.1z
                        M42,29.8c-2.9-1-6-1.4-9-1.1c-1.6,0.1-3.1,0.5-4.5,1l-0.3,0.1v3.9l6.5-2.4c1.3-0.4,2.6-0.5,3.9-0.2c1,0.3,0.8,0.9-0.4,1.4
                    l-10,3.7V40L42,34.9c1-0.4,1.9-0.9,2.7-1.7C45.4,32.2,45.1,30.8,42,29.8z" fill="#ffffff"></path>
                        </g>
                    </g>
                </svg>
            <% } else if(platform_name === 'PC') { %>
                <svg fill="#ffffff" width="25px" height="25px" viewBox="0 0 32 32" version="1.1" xmlns="http://www.w3.org/2000/svg">
                    <path d="M18.102 12.129c0-0 0-0 0-0.001 0-1.564 1.268-2.831 2.831-2.831s2.831 1.268 2.831 2.831c0 1.564-1.267 2.831-2.831 2.831-0 0-0 0-0.001 0h0c-0 0-0 0-0.001 0-1.563 0-2.83-1.267-2.83-2.83 0-0 0-0 0-0.001v0zM24.691 12.135c0-2.081-1.687-3.768-3.768-3.768s-3.768 1.687-3.768 3.768c0 2.081 1.687 3.768 3.768 3.768v0c2.080-0.003 3.765-1.688 3.768-3.767v-0zM10.427 23.76l-1.841-0.762c0.524 1.078 1.611 1.808 2.868 1.808 1.317 0 2.448-0.801 2.93-1.943l0.008-0.021c0.155-0.362 0.246-0.784 0.246-1.226 0-1.757-1.424-3.181-3.181-3.181-0.405 0-0.792 0.076-1.148 0.213l0.022-0.007 1.903 0.787c0.852 0.364 1.439 1.196 1.439 2.164 0 1.296-1.051 2.347-2.347 2.347-0.324 0-0.632-0.066-0.913-0.184l0.015 0.006zM15.974 1.004c-7.857 0.001-14.301 6.046-14.938 13.738l-0.004 0.054 8.038 3.322c0.668-0.462 1.495-0.737 2.387-0.737 0.001 0 0.002 0 0.002 0h-0c0.079 0 0.156 0.005 0.235 0.008l3.575-5.176v-0.074c0.003-3.12 2.533-5.648 5.653-5.648 3.122 0 5.653 2.531 5.653 5.653s-2.531 5.653-5.653 5.653h-0.131l-5.094 3.638c0 0.065 0.005 0.131 0.005 0.199 0 0.001 0 0.002 0 0.003 0 2.342-1.899 4.241-4.241 4.241-2.047 0-3.756-1.451-4.153-3.38l-0.005-0.027-5.755-2.383c1.841 6.345 7.601 10.905 14.425 10.905 8.281 0 14.994-6.713 14.994-14.994s-6.713-14.994-14.994-14.994c-0 0-0.001 0-0.001 0h0z"></path>
                </svg>
            <% } else if(platform_name === 'Xbox Series X/S') { %>
                <svg width="25px" height="25px" viewBox="0 0 250 250" version="1.1" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" xml:space="preserve" xmlns:serif="http://www.serif.com/" style="fill-rule:evenodd;clip-rule:evenodd;stroke-linejoin:round;stroke-miterlimit:2;">
                    <g transform="matrix(0.991581,0,0,0.991581,0,0)">
                        <path id="path4" d="M125.904,101.1C125.904,101.1 126.218,101.1 125.904,101.1C163.895,129.986 228.261,200.945 208.794,221.039C186.502,240.506 157.616,252.123 125.904,252.123C94.193,252.123 64.993,240.506 43.015,221.039C23.234,200.945 87.913,129.986 125.59,101.414C125.59,101.1 125.904,101.1 125.904,101.1ZM191.525,18.525C172.373,6.907 151.336,0 125.904,0C100.472,0 79.436,6.907 60.283,18.525C59.969,18.525 59.969,18.839 59.969,19.153C59.969,19.467 60.283,19.467 60.597,19.467C85.087,14.129 122.137,35.165 125.59,37.363L126.218,37.363C129.672,35.165 166.721,14.129 191.211,19.467C191.525,19.467 191.839,19.467 191.839,19.153C191.839,18.839 191.839,18.525 191.525,18.525ZM37.677,36.107C37.363,36.107 37.363,36.421 37.049,36.421C14.129,59.341 0,91.053 0,125.904C0,154.476 9.733,181.164 25.746,202.201C25.746,202.514 26.06,202.514 26.374,202.514C26.688,202.514 26.688,202.201 26.374,201.887C16.641,172.059 65.935,100.158 91.367,70.017L91.681,69.703C91.681,69.389 91.681,69.389 91.367,69.389C52.748,31.084 39.875,35.165 37.677,36.107ZM160.442,69.075L160.128,69.389C160.128,69.389 160.128,69.703 160.442,69.703C185.874,99.844 234.854,171.745 225.435,201.573L225.435,202.201C225.749,202.201 226.063,202.201 226.063,201.887C242.075,180.85 251.809,154.162 251.809,125.59C251.809,90.739 237.68,59.027 214.446,36.107C214.132,35.793 214.132,35.793 213.818,35.793C211.934,35.165 199.061,31.084 160.442,69.075Z" style="fill:rgb(255, 255, 255);fill-rule:nonzero;"/>
                    </g>
                </svg>
            <% } %>    
        <% }); %>
    </div>
    <dialog id="password-modal" class="password-modal">
        <h3>Admin Confirmation Required</h3>
        <p>please enter the admin password to complete your action</p>
        <label for="password">Password</label>
        <input type="password" id="password" name="password" form="delete-form" required>        
        <div class="modal-actions">
            <button type="button" id="cancel-btn">&times;</button>
            <button type="submit" form="delete-form">Confirm</button>
        </div>
    </dialog>
    <script src="https://unpkg.com/colorthief@3/dist/umd/color-thief.global.js"></script>
    <script src="/bgColorAdjustment.js"></script>
    <script src="/actionConfirmation.js"></script>
</body>
</html>